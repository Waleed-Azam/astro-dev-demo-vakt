{
  "name": "vakt-saas-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Vakt — uptime monitoring SaaS marketing site + docs + changelog + status, built in Astro on Cloudflare + Resend + Railway.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
