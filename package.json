    "check": "astro check"
  },
  "dependencies": {
    "astro": "^4.16.4",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^10.2.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
