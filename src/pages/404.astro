---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Vakt" currentPath="/">
  <section class="section"><div class="container center" style="max-width:560px">
    <p class="eyebrow">Error 404</p>
    <h1 class="display" style="margin-top:.8rem">This endpoint <span class="lime">doesn't respond.</span></h1>
    <p class="lead" style="margin-top:1rem">Unlike our monitors, this page has no redundancy. Let's get you back.</p>
    <div style="margin-top:1.6rem;display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap">
      <a href="/" class="btn btn-lime">Back home</a><a href="/docs" class="btn btn-ghost">Read the docs</a>
    </div>
  </div></section>
</BaseLayout>
