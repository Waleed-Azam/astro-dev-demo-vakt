---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import Faq from '../components/Faq.astro';

const plans = [
  { name: 'Hobby', price: '$0', per: 'forever', desc: 'Side projects and homelabs.', cta: 'Start for free', feat: false,
    rows: [['5 monitors, 5-min checks', true], ['1 status page', true], ['Email alerts', true], ['30-day history', true], ['30-second checks', false], ['Rotations & SSO', false]] },
  { name: 'Pro', price: '$19', per: '/mo from', desc: 'Teams that ship and sleep.', cta: 'Start 14-day trial', feat: true,
    rows: [['100 monitors, 30-sec checks', true], ['Unlimited status pages', true], ['Slack, PagerDuty, webhooks', true], ['Rotations + SSO', true], ['Multi-step flows', true], ['Dedicated support', false]] },
  { name: 'Enterprise', price: 'Custom', per: 'annual', desc: 'Regulated, huge, or both.', cta: 'Talk to us', feat: false,
    rows: [['Unlimited everything', true], ['EU data residency', true], ['Audit log + SAML/SCIM', true], ['99.99% uptime SLA', true], ['Dedicated CSM', true], ['Onboarding help', true]] },
];
const faqs = [
  { q: 'Do unused monitors cost money?', a: 'No — paused monitors are free forever. You only pay for active checks, and the calculator above shows exactly what that means for your setup.' },
  { q: 'Can we pay annually?', a: 'Yes — yearly billing saves 20% on Pro. Enterprise is annual by default with procurement-friendly invoicing.' },
  { q: 'What counts as a monitor?', a: 'One URL (or flow) being checked. A 30-second check and a 5-minute check both count as one monitor — only the interval multiplier differs.' },
];
---
<BaseLayout title="Pricing — Vakt" description="Transparent per-monitor pricing. Start free, scale to 30-second checks across 12 regions." currentPath="/pricing">
  <section class="page-hero"><div class="container center">
    <p class="eyebrow">Pricing</p>
    <h1 class="h-lg" style="margin-top:.7rem">Start free. <span class="lime">Scale when it hurts.</span></h1>
    <p class="lead" style="margin-top:.8rem">Every plan includes unlimited team seats on trial, all 12 regions, and status pages. No per-seat traps.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="grid-3">
      {plans.map((p, i) => (
        <div class={`plan${p.feat ? ' featured' : ''} reveal reveal-d${i}`}>
          {p.feat && <span class="plan-flag">Most popular</span>}
          <h2 class="h-sm">{p.name}</h2><p class="muted">{p.desc}</p>
          <p class="plan-price">{p.price} <small>{p.per}</small></p>
          <ul>{p.rows.map((r) => (<li class={r[1] ? '' : 'off'}>{r[0]}</li>))}</ul>
          <p style="margin-top:auto;padding-top:1rem"><a href="/signup" class={`btn ${p.feat ? 'btn-lime' : 'btn-ghost'}`} style="width:100%;justify-content:center">{p.cta}</a></p>
        </div>
      ))}
    </div>
    <div style="margin-top:var(--s5)">
      <div class="center reveal"><h2 class="h-md">Estimate your exact bill</h2><p class="muted">Same calculator as the homepage — try your real numbers.</p></div>
      <div style="margin-top:var(--s3)"><PricingCalculator /></div>
    </div>
    <div style="max-width:820px;margin:var(--s5) auto 0">
      <div class="center reveal"><h2 class="h-md">Pricing questions</h2></div>
      <div style="margin-top:var(--s3)"><Faq items={faqs} /></div>
    </div>
  </div></section>
</BaseLayout>
